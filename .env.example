# ---------------------------------------------------------------------------
# Magnemite — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Host port our Caddy publishes, in plain HTTP. Your own reverse proxy
# terminates TLS and forwards to it; nothing here listens on 80 or 443.
EDGE_PORT=8080
# Public base URL handed to agents at enrollment time. Artifact URLs are built
# from it, so it must be what the boxes can actually reach.
MAGNEMITE_PUBLIC_URL=https://magnemite.example.com

# --- Database --------------------------------------------------------------
# Which Prisma connector to use: "postgresql" (default) or "mysql", which also
# covers MariaDB -- Prisma has no separate mariadb provider. deploy/compose.yml
# pins "postgresql" for the Postgres it runs; deploy/compose.mariadb.yml reads
# this one, defaulting to "mysql", because its database is external. Changing
# it needs a rebuild: the Prisma Client is generated into the images. See
# packages/db/prisma.config.ts.
DB_PROVIDER=postgresql

DB_USER=magnemite
DB_PASSWORD=change-me-please
DB_NAME=magnemite
# Used when running Prisma or the apps outside docker -- and by
# deploy/compose.mariadb.yml, which runs no database of its own and hands this
# straight to the containers. With deploy/compose.yml the URL is built from the
# DB_* values above instead, so this line does not need to be right there.
#
# Careful with the two uses: the value below points at the host-published port,
# which is what a container cannot reach. An external database needs its own
# address here.
DATABASE_URL=postgresql://magnemite:change-me-please@localhost:5433/magnemite?schema=public

# --- Auth (Better Auth) ----------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me-please
# The dashboard's own origin, checked by Better Auth. With the Caddy setup this
# is the same host as MAGNEMITE_PUBLIC_URL and compose fills it in for you; it
# only needs setting when the dashboard and the agents are on separate domains,
# as in deploy/compose.coolify.yml.
MAGNEMITE_DASHBOARD_URL=https://magnemite.example.com
# Base URL Better Auth builds callbacks from. Defaults to
# MAGNEMITE_DASHBOARD_URL (then Coolify's SERVICE_FQDN_WEB); a bare host with
# no scheme is accepted. Only set it when neither of those is right.
# BETTER_AUTH_URL=https://magnemite.example.com
# Seeded on `pnpm db:seed`. Re-running the seed resets this password, which is
# the way back in if you lose the admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Hub -------------------------------------------------------------------
HUB_PORT=3001
# Interface the hub binds to.
HUB_HOST=0.0.0.0
# Where the dashboard reaches the hub's internal API. Inside compose this is
# the service name; outside docker it is http://localhost:3001.
HUB_URL=http://hub:3001
# Shared secret for web -> hub internal calls (SSE, dispatch nudges).
HUB_INTERNAL_SECRET=change-me-please
# Where cached .apkm artifacts live when running the hub outside docker.
# Inside compose this is always /data/artifacts, mounted into caddy.
ARTIFACT_DIR=../../data/artifacts
# Serve /files/* from the hub itself. Leave false in production: Caddy serves
# the artifacts off the shared volume, keeping Node out of the data path.
SERVE_ARTIFACTS=false

# --- Agent self-update -----------------------------------------------------
# The hub image ships the binaries it wants the fleet to run, so a box that
# reconnects on an older build is told to update itself. false pins the fleet
# and leaves updates to be driven by hand.
AGENT_AUTO_UPDATE=true
# Where the hub image keeps those binaries, next to the VERSION they were
# built from. Only worth changing outside docker.
AGENT_BIN_DIR=/app/agent-bin
# Max concurrent jobs, job stall timeout, source poll interval, the auto-update
# cooldown, concurrent agent updates and the device offline timeout all live in
# Settings → Hub, not here.

# --- Rotom (optional) ------------------------------------------------------
# With this on, the hub asks Rotom once a minute what it thinks of each box.
# Read-only: it feeds the Scanner column and the "Rotom lost the box" monitoring
# rule. Installs do not touch Rotom.
ROTOM_ENABLED=false
# RotomNG's HTTP listener. /api is appended, so either form works.
ROTOM_URL=http://rotom:7072
# Matches `secret` under http_listener in the Rotom config.
ROTOM_SECRET=
# BasicAuth for a reverse proxy in front of Rotom. Separate from the secret
# above, not an alternative to it: set either, or both when the proxy gates a
# Rotom that also checks its own secret.
ROTOM_BASIC_USERNAME=
ROTOM_BASIC_PASSWORD=

# --- Logging ---------------------------------------------------------------
# Hub log level (pino): trace|debug|info|warn|error|fatal. Defaults to debug
# outside production, info in it.
# LOG_LEVEL=info
# Set to 1 to log every Prisma query. Noisy; development only.
# PRISMA_LOG=0
