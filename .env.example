# ---------------------------------------------------------------------------
# Magnemite — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Domain served by Caddy. Use ":80" for local development without TLS.
MAGNEMITE_DOMAIN=magnemite.example.com
# Public base URL handed to agents at enrollment time.
MAGNEMITE_PUBLIC_URL=https://magnemite.example.com
# Email used by Caddy for the Let's Encrypt account.
ACME_EMAIL=you@example.com

# --- Database --------------------------------------------------------------
POSTGRES_USER=magnemite
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=magnemite
# Used by web + hub inside compose. Change the host to localhost:5433 to run
# the apps outside docker against the compose database.
DATABASE_URL=postgresql://magnemite:change-me-please@postgres:5432/magnemite?schema=public

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me-please
# Seeded on `pnpm db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Hub -------------------------------------------------------------------
HUB_PORT=3001
# Shared secret for web -> hub internal calls (SSE, dispatch nudges).
HUB_INTERNAL_SECRET=change-me-please
# Where cached .apkm artifacts live (mounted into caddy as /srv/artifacts).
ARTIFACT_DIR=/data/artifacts
# Fleet-wide cap on devices downloading/installing at the same time.
MAX_CONCURRENT_JOBS=10
# Seconds without a job_progress message before a job is considered stalled.
JOB_STALL_TIMEOUT=900

# --- Version sources -------------------------------------------------------
GITHUB_REPO=The-Treeline-Project/Silva-Releases
# Optional. Raises the GitHub API rate limit from 60/h to 5000/h.
GITHUB_TOKEN=
MIRROR_INDEX_URL=https://mirror.unownhash.com/index.json
MIRROR_BASE_URL=https://mirror.unownhash.com/apks/
# How often to poll both sources, in minutes.
SOURCE_POLL_MINUTES=15

# --- Rotom (optional) ------------------------------------------------------
ROTOM_ENABLED=false
ROTOM_URL=http://rotom:7072
ROTOM_SECRET=
