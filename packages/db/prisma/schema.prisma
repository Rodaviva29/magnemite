generator client {
  provider      = "prisma-client-js"
  // "native" covers local development on Windows/macOS; the musl target is
  // what the alpine-based hub and web images actually load.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum VersionSource {
  /// Discovered by polling a source feed. Which one is on `feedId`.
  MIRROR
  /// Uploaded by hand through the dashboard.
  MANUAL
}

enum VersionStatus {
  DISCOVERED // seen at the source, not downloaded yet
  CACHING // being downloaded onto the VPS
  READY // cached + hashed, installable
  FAILED
}

enum RolloutMode {
  MANUAL
  AUTO
}

enum RolloutStatus {
  PENDING
  CANARY // canary jobs dispatched
  SOAKING // canary succeeded, waiting out soakMinutes
  RUNNING // full fleet dispatched
  PAUSED // canary failed or operator paused
  COMPLETED
  CANCELLED
}

/// Doubles as the current phase of a running job, which is what the dashboard
/// renders next to the progress bar.
enum JobState {
  QUEUED // waiting for a slot, or for the device to come online
  DISPATCHED // sent to the agent, not acknowledged yet
  DOWNLOADING
  EXTRACTING
  INSTALLING
  VERIFYING
  SUCCESS
  FAILED
  CANCELLED
  SKIPPED
}

enum InstallMode {
  IN_PLACE // pm install-create -r, app data preserved
  CLEAN // pm uninstall first, app data wiped
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Device {
  id     String @id @default(cuid())
  name   String
  /// ro.serialno, or a MAC-derived fallback. Identifies the box across
  /// re-enrollments and IP changes.
  serial String @unique

  manufacturer   String?
  model          String?
  androidVersion String?
  sdkInt         Int?
  abi            String?
  agentVersion   String?

  /// sha256 of the bearer token the agent presents. The plaintext token is
  /// shown once at enrollment and never stored.
  tokenHash String  @unique
  approved  Boolean @default(false)

  status        DeviceStatus @default(OFFLINE)
  lastSeenAt    DateTime?
  /// Address the socket came from. Behind the reverse proxy this is the same
  /// internal 10.x for every box, which is why the UI shows localIp instead.
  publicIp      String?
  /// The box's own LAN address, as reported by the agent. Null on agents old
  /// enough not to send it.
  localIp       String?
  freeBytes     BigInt?
  totalBytes    BigInt?
  uptimeSeconds Int?

  /// Run-queue averages and memory, straight off /proc on each heartbeat.
  /// Null on boxes running an agent old enough not to report them.
  loadAvg1          Float?
  loadAvg5          Float?
  loadAvg15         Float?
  cpuCount          Int?
  memTotalBytes     BigInt?
  memAvailableBytes BigInt?
  /// When the agent last sent a full third-party package list, as opposed to
  /// just the tracked apps.
  packagesSyncedAt  DateTime?

  // --- Rotom (optional integration) ---------------------------------------
  /// The `origin` this box reports to Rotom.
  rotomOrigin      String?
  /// Rotom's own device id, the handle its action endpoints take.
  rotomDeviceId    String?
  /// Whether Rotom currently has a live socket to this box. This — not
  /// `pm` printing Success — is the real proof an update left it scanning.
  rotomConnected   Boolean   @default(false)
  rotomWorkerCount Int?
  rotomLastSeenAt  DateTime?
  /// Set while Magnemite has the box disabled in Rotom for an install, so a
  /// crash mid-job cannot leave it parked out of the scanning pool forever.
  rotomDisabledBy  String?

  notes   String?
  groupId String?
  group   DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  packages     DevicePackage[]
  jobs         Job[]
  agentUpdates AgentUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([groupId])
}

/// Installed version of each package we track, refreshed on every heartbeat.
/// One attempt at swapping the agent binary on a box.
///
/// The row is written when the hub sends the update and closed when the box
/// comes back — on the new version, or with the error the agent reported. It
/// is what makes an agent update as auditable as an app update: without it a
/// failed self-update is invisible, because the only symptom is a box that
/// keeps reconnecting on the old version.
model AgentUpdate {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Null when the box never reported a version before this update.
  fromVersion String?
  toVersion   String
  state       AgentUpdateState @default(SENT)
  /// What the agent said went wrong. Null unless state is FAILED.
  error       String?

  sentAt     DateTime  @default(now())
  finishedAt DateTime?

  @@index([deviceId, sentAt])
}

enum AgentUpdateState {
  SENT // told to update, not seen on the new version yet
  SUCCESS // reconnected running the new binary
  FAILED // the agent reported a download, checksum or swap failure
}

model DevicePackage {
  id          String  @id @default(cuid())
  deviceId    String
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName String
  versionName String?
  versionCode BigInt?
  installed   Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([deviceId, packageName])
  @@index([packageName, versionName])
}

model DeviceGroup {
  id   String @id @default(cuid())
  name String @unique

  /// Shell run as root on the device before the install session opens.
  /// Typically stops the scanner: `am force-stop <pkg>`.
  preInstallHook  String?
  /// Shell run as root after the install is verified. Typically restarts the
  /// scanner and re-applies the mod.
  postInstallHook String?

  /// Overrides the fleet-wide MAX_CONCURRENT_JOBS for boxes in this group,
  /// e.g. to protect a site on a thin uplink.
  maxConcurrency Int?

  devices Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Apps + versions
// ---------------------------------------------------------------------------

model AppTarget {
  id          String  @id @default(cuid())
  packageName String  @unique
  displayName String
  enabled     Boolean @default(true)

  /// Set on targets created by a manual upload rather than configured as a
  /// watched app. They have no source to poll and no auto-update policy: the
  /// Fleet and Versions pages are about the watched app and skip these, while
  /// the agent still reports their installed version like any other.
  manual Boolean @default(false)

  /// Only versions built for this ABI are tracked. Android TV boxes in this
  /// fleet are arm64; add a second target if that ever stops being true.
  arch String @default("arm64-v8a")

  // --- auto-update policy -------------------------------------------------
  autoUpdateEnabled Boolean @default(false)
  /// New versions are marked approved on discovery instead of waiting for a
  /// human to press approve.
  autoApprove       Boolean @default(false)
  /// Devices updated first; the rest wait for them to succeed.
  canaryCount       Int     @default(1)
  /// Minutes to wait after the canary succeeds before releasing the fleet.
  soakMinutes       Int     @default(30)
  maxConcurrency    Int?
  maxAttempts       Int     @default(3)
  /// "HH:MM" local time. When both are set, auto rollouts only dispatch
  /// inside this window.
  windowStart       String?
  windowEnd         String?

  versions AppVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A place that publishes an index of installable builds.
///
/// Every feed speaks the same shape — the flat JSON array the UnownHash mirror
/// serves — so adding one is a URL in Settings rather than code. Entries may
/// carry an absolute `url`, in which case `baseUrl` is not needed.
model SourceFeed {
  id       String  @id @default(cuid())
  name     String  @unique
  /// The index.json to poll.
  indexUrl String
  /// Prefix for entries whose `filename` is not an absolute URL. Null when the
  /// index publishes `url` on every entry.
  baseUrl  String?
  enabled  Boolean @default(true)
  /// Lowest wins when two feeds publish the same version of the same build.
  /// The version is stored once; this decides whose URL is downloaded.
  priority Int     @default(100)

  versions AppVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppVersion {
  id          String    @id @default(cuid())
  appTargetId String
  appTarget   AppTarget @relation(fields: [appTargetId], references: [id], onDelete: Cascade)

  /// Marketing version, e.g. "0.425.1".
  version     String
  /// Play build code from the GitHub tag, e.g. "2026081202".
  buildCode   String?
  /// Android versionCode, filled in once a device reports it.
  versionCode BigInt?

  source    VersionSource
  /// Which feed listed it. Null for manual uploads.
  feedId    String?
  feed      SourceFeed?   @relation(fields: [feedId], references: [id], onDelete: SetNull)
  arch      String        @default("arm64-v8a")
  remoteUrl String
  filename  String
  sizeBytes BigInt

  /// From the feed index, when it publishes one. Feeds that publish no hash
  /// leave this null and the download is checked by size.
  md5    String?
  /// Computed by the hub after caching. This is what agents verify against.
  sha256 String?

  /// Path inside ARTIFACT_DIR, served by Caddy as /files/<basename>.
  artifactPath  String?
  status        VersionStatus @default(DISCOVERED)
  cacheProgress Int           @default(0)
  error         String?

  approved     Boolean   @default(false)
  publishedAt  DateTime?
  discoveredAt DateTime  @default(now())

  rollouts Rollout[]

  /// One row per build, whichever feed happened to list it first. Two feeds
  /// mirroring the same release are the same thing to everyone downstream —
  /// the fleet, the rollouts, the Versions page — so it is stored once.
  @@unique([appTargetId, version, arch])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Rollouts + jobs
// ---------------------------------------------------------------------------

model Rollout {
  id           String     @id @default(cuid())
  appVersionId String
  appVersion   AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Restrict)

  mode   RolloutMode   @default(MANUAL)
  status RolloutStatus @default(PENDING)

  /// Uninstall before installing on every device, wiping app data, instead of
  /// only falling back to it when an in-place upgrade is rejected.
  forceClean     Boolean @default(false)
  canaryCount    Int     @default(0)
  soakMinutes    Int     @default(0)
  maxConcurrency Int?
  maxAttempts    Int     @default(3)

  /// Hooks for this rollout only, overriding the ones on the device's group.
  /// A manual install of some other app needs to stop and start that app, not
  /// whatever the group stops for the watched one.
  preInstallHook  String?
  postInstallHook String?

  note        String?
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  canaryPassedAt DateTime?
  finishedAt     DateTime?

  jobs Job[]

  @@index([status])
}

model Job {
  id        String  @id @default(cuid())
  rolloutId String
  rollout   Rollout @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  state    JobState @default(QUEUED)
  /// 0-100 within the current state. Download progress is the slow one.
  progress Int      @default(0)
  isCanary Boolean  @default(false)

  attempt   Int     @default(0)
  lastError String?

  installMode InstallMode?
  /// True when the install had to fall back to uninstall, or forceClean was
  /// set. Surfaced in the UI because it means the box lost its app data.
  dataWiped   Boolean      @default(false)

  fromVersion String?
  toVersion   String

  queuedAt     DateTime  @default(now())
  dispatchedAt DateTime?
  startedAt    DateTime?
  /// Last progress message from the agent, used to detect stalled jobs.
  heartbeatAt  DateTime?
  finishedAt   DateTime?

  events JobEvent[]

  @@unique([rolloutId, deviceId])
  @@index([state])
  @@index([deviceId, state])
}

model JobEvent {
  id      String    @id @default(cuid())
  jobId   String
  job     Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ts      DateTime  @default(now())
  level   LogLevel  @default(INFO)
  phase   JobState?
  message String

  @@index([jobId, ts])
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

model EnrollmentToken {
  id        String @id @default(cuid())
  label     String
  /// sha256 of the token. The plaintext is shown once, when it is created.
  tokenHash String @unique
  /// First 8 chars of the plaintext, so the UI can tell tokens apart.
  prefix    String

  /// Devices enrolling with this token skip manual approval.
  autoApprove Boolean   @default(true)
  maxUses     Int?
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Better Auth
//
// These four models are the shape Better Auth's Prisma adapter expects; the
// only addition is `role`, declared as an additional field in the auth config.
// Passwords live on Account (providerId "credential"), hashed with bcrypt so
// the database seed can create the first admin without pulling Better Auth
// into the db package.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(VIEWER)

  sessions Session[]
  accounts Account[]
  rollouts Rollout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id @default(cuid())
  /// Namespaces the identity so an OAuth provider id can never collide with a
  /// local one. Credential accounts use "local:credential"
  /// (`CREDENTIAL_ISSUER` in @magnemite/db) — sign-in looks the account up by
  /// this, so a row without it simply will not authenticate.
  issuer     String
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// bcrypt hash for credential accounts; null for OAuth providers.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Fleet-wide key/value settings that are editable from the dashboard.
/// Anything that belongs in infrastructure config lives in env instead.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
